<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sorry 🥺❤️</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #ff758c, #ff7eb3);
  font-family: Arial, sans-serif;
  overflow: hidden;
}

.card {
  width: 90%;
  max-width: 380px;
  background: white;
  padding: 35px 25px;
  border-radius: 25px;
  text-align: center;
  box-shadow: 0 15px 40px rgba(0,0,0,0.25);
  z-index: 2;
}

.emoji {
  font-size: 65px;
}

h1 {
  color: #ff3f68;
}

input {
  width: 100%;
  padding: 14px;
  border: 2px solid #ffd0da;
  border-radius: 12px;
  font-size: 16px;
  outline: none;
}

button {
  width: 100%;
  margin-top: 15px;
  padding: 14px;
  border: none;
  border-radius: 12px;
  background: #ff3f68;
  color: white;
  font-size: 17px;
  font-weight: bold;
}

#message {
  margin-top: 20px;
  font-size: 21px;
  font-weight: bold;
  color: #ff3f68;
}

.heart {
  position: fixed;
  bottom: -50px;
  font-size: 35px;
  animation: pop 2.5s linear forwards;
  z-index: 1;
}

@keyframes pop {
  0% {
    transform: translateY(0) scale(0);
    opacity: 0;
  }

  20% {
    opacity: 1;
    transform: scale(1.2);
  }

  100% {
    transform: translateY(-110vh) rotate(360deg) scale(1);
    opacity: 0;
  }
}
</style>
</head>

<body>

<div class="card">
  <div class="emoji">🥺</div>

  <h1>I'm Sorry ❤️</h1>

  <input
    id="answer"
    type="text"
    placeholder="Type your answer..."
    autocomplete="off"
  >

  <button onclick="checkAnswer()">Submit ❤️</button>

  <div id="message"></div>
</div>

<script>
function checkAnswer() {

  const input = document.getElementById("answer");
  const message = document.getElementById("message");

  const answer = input.value.trim().toLowerCase();

  if (
    answer === "thik hai" ||
    answer === "theek hai" ||
    answer === "thik h" ||
    answer === "okay" ||
    answer === "ok"
  ) {

    message.innerHTML = "Thank you ❤️🥺";

    // Heart pop-up
    for (let i = 0; i < 25; i++) {

      const heart = document.createElement("div");

      heart.className = "heart";
      heart.innerHTML = Math.random() > 0.5 ? "❤️" : "💕";

      heart.style.left = Math.random() * 100 + "vw";
      heart.style.animationDelay = Math.random() * 1.5 + "s";

      document.body.appendChild(heart);

      setTimeout(() => {
        heart.remove();
      }, 3500);
    }

  } else {

    message.innerHTML = "Please forgive me 🥺❤️";

    setTimeout(() => {
      message.innerHTML = "";
      input.value = "";
      input.focus();
    }, 1500);
  }
}
</script>

</body>
</html>
